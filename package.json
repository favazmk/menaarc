{
  "name": "menaarc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "film": "npm run film:desktop && npm run film:mobile",
    "ingest": "node scripts/ingest-projects.mjs",
    "typecheck": "tsc --noEmit",
    "film:desktop": "node scripts/build-film.mjs --in assets/masters/villa-journey-16x9.mp4 --tier desktop --frames 240 --width 1280 --crf 32 --sharpen 0.8 --delogo 1132:556:72:78",
    "film:mobile": "node scripts/build-film.mjs --in assets/masters/villa-journey-9x16.mp4 --tier mobile --frames 160 --width 720 --crf 32 --sharpen 0.8 --delogo 574:1131:56:58",
    "check:content": "node scripts/check-content.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prebuild": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
